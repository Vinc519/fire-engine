# =============================================================================
# .clang-format — Fire Engine
# Full configuration of the clang-format automatic formatter.
# Official documentation: https://clang.llvm.org/docs/ClangFormatStyleOptions.html
#
# Regenerate from a base style:
#   clang-format -style=llvm -dump-config > .clang-format
#
# Apply manually  : clang-format -i file.cpp
# Check only      : clang-format --dry-run --Werror file.cpp
# =============================================================================

Language:        Cpp
Standard:        c++20
BasedOnStyle:    LLVM

AccessModifierOffset: 0
AlignArrayOfStructures: Right
AlignEscapedNewlines: LeftWithLastLine
AlignTrailingComments:
  OverEmptyLines: 5
AttributeMacros:
  - INLINE
  - FORCE_INLINE
ColumnLimit: 100
IncludeCategories:
  - Regex: ^"(core|platform|renderer|input|audio|physics|sandbox)/
    Priority: 1
    SortPriority: 0
    CaseSensitive: false
  - Regex: ^"third_party/
    Priority: 2
    SortPriority: 0
    CaseSensitive: false
  - Regex: ^<
    Priority: 3
    SortPriority: 0
    CaseSensitive: false
  - Priority: 4
    CaseSensitive: false
    SortPriority: 0
    Regex: .*
StatementMacros:
  - FE_ASSERT
  - FE_ASSERT_MSG
  - FE_LOG_FATAL
  - FE_LOG_ERROR
  - FE_LOG_WARNING
  - FE_LOG_INFO
  - FE_LOG_DEBUG
  - FE_LOG_TRACE
TabWidth: 4
UseTab: ForIndentation

IndentWidth: 4
IndentPPDirectives: AfterHash
PPIndentWidth: 4

IndentCaseLabels: true

BreakBeforeBraces: Allman

AlignConsecutiveMacros:
    Enabled: true
    AcrossEmptyLines: true
    AcrossComments: true

AllowShortBlocksOnASingleLine: Empty